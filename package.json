{
  "name": "cleancity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --exclude build/**",
    "preview": "vite preview --host 127.0.0.1",
    "iot:local": "node server/local/main.ts",
    "iot:ports": "node server/local/main.ts --list",
    "wifi:gateway": "node --env-file=.env server/municipal/local-wifi-gateway.mjs",
    "api:dev": "tsx --env-file=.env server/municipal/main.ts",
    "auth:hash": "tsx scripts/hash-operator-password.ts",
    "test:atlas": "node --env-file=.env node_modules/vitest/vitest.mjs run server/municipal/atlas.integration.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "0.468.0",
    "mongodb": "^7.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "^5.0.6",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "27.2.0",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
