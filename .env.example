# Server only. Never prefix privileged values with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Enable intentionally after reviewing the public read-only demo endpoint.
PUBLIC_PHYSICAL_DEMO=false

# F2 municipal API: SERVER ONLY. Existing USB/SQLite receiver is separate.
MONGODB_URI=
MONGODB_DATABASE=cleancity_development
APP_ORIGIN=http://127.0.0.1:5182
MUNICIPAL_PORT=3001
OPERATOR_USERNAME=operator
# Hash generated by scripts/hash-operator-password.ts; never plaintext.
# --local-demo allows short passwords only for loopback development; production rejects these hashes.
OPERATOR_PASSWORD_HASH=
WORKSPACE_ID=municipal
